{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fc-event-calendar",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fc-event-calendar",
      "database_id": "e941301d-f2fb-46fe-9008-be688559fdbf",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "RAID_HELPER_SERVER_ID": "742815677236248746",
    "RAID_HELPER_CHANNEL_ID": "742841036665127012"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
